{
  "pipeline_name": "crypto-insight-dashboard-batch",
  "data_quality_slo": {
    "freshness_minutes_4h_bucket": 30,
    "max_429_rate": 0.05
  },

  "alerts": [
    {
      "alert_id": "CRITICAL_JOB_FAILURE",
      "severity": "CRITICAL",
      "metric_type": "JOB_HEALTH",
      "condition": "last_run_status == 'FAILED'",
      "target_jobs": [
        "pipeline/bronze/binance_klines.ipynb",
        "pipeline/bronze/fear_greed_index.py",
        "pipeline/silver/transform_charts.ipynb",
        "pipeline/silver/transform_fear_greed.ipynb",
        "pipeline/gold/price_signals.ipynb",
        "pipeline/gold/fear_greed_metrics.ipynb",
        "pipeline/gold/joined_dashboard.ipynb"
      ],
      "action": ["SLACK_CHANNEL_OPS", "EMAIL_OPS_TEAM"]
    },
    {
      "alert_id": "DQ_ASSERTION_FAILURE",
      "severity": "CRITICAL",
      "metric_type": "DATA_QUALITY_CHECK",
      "source_notebooks": [
        "pipeline/silver/transform_charts.ipynb",
        "pipeline/silver/transform_fear_greed.ipynb"
      ],
      "condition": "assert_error_raised == true",
      "description": "Silver 노트북 마지막 셀의 DQ 어서션(null/범위 검증)이 실패해 노트북이 중단되었습니다. RUNBOOK.md 시나리오 1 참고.",
      "action": ["SLACK_CHANNEL_OPS"]
    },
    {
      "alert_id": "FRESHNESS_LAG_VIOLATION",
      "severity": "HIGH",
      "metric_type": "BUCKET_AGE",
      "source_table": "gold_price_positions_4h",
      "condition": "minutes_since(MAX(bucket_start)) > 30",
      "description": "gold_price_positions_4h의 최신 bucket_start가 예상 폴링 주기(4시간봉 기준 30분 이내 갱신)를 벗어났습니다. RUNBOOK.md 시나리오 2 참고.",
      "action": ["SLACK_CHANNEL_OPS"]
    },
    {
      "alert_id": "DATA_SKEW_WARNING",
      "severity": "MEDIUM",
      "metric_type": "SPARK_PERFORMANCE",
      "condition": "p95_task_duration > 5 * p50_task_duration",
      "description": "최대 Task 실행 시간이 중간값의 5배를 초과했습니다. 데이터 Skew 또는 리소스 부족이 의심됩니다. (Spark UI 진단 필요)",
      "action": ["SLACK_CHANNEL_OPS"]
    },
    {
      "alert_id": "API_RATE_LIMIT_EXCEEDED",
      "severity": "HIGH",
      "metric_type": "UPSTREAM_API_HEALTH",
      "source_api": "Binance",
      "condition": "429_rate > 0.05",
      "description": "API 429 (Rate Limit) 에러 비율이 임계치(5%)를 초과했습니다. Bronze 수집 속도 저하 또는 중단 위험.",
      "action": ["SLACK_CHANNEL_OPS"]
    },
    {
      "alert_id": "DATA_QUALITY_FGI_RANGE",
      "severity": "WARNING",
      "metric_type": "DATA_QUALITY_CHECK",
      "source_table": "silver_fear_greed",
      "condition": "index_value NOT BETWEEN 0 AND 100",
      "description": "Fear & Greed 지수(index_value)가 정상 범위(0~100)를 벗어났습니다.",
      "action": ["SLACK_CHANNEL_OPS"]
    }
  ]
}
